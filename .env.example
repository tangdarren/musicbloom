# MusicBloom environment configuration
#
# Copy this file to .env and adjust values for your environment.
# All variables use the MUSICBLOOM_ prefix (configured in config.py).

# Core application
MUSICBLOOM_ENVIRONMENT=development
MUSICBLOOM_DEBUG=true
MUSICBLOOM_DEMO_MODE=true

# API server
MUSICBLOOM_API_HOST=0.0.0.0
MUSICBLOOM_API_PORT=8000

# CORS (comma-separated origins)
MUSICBLOOM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Security — required in production; generate a strong random value locally
# MUSICBLOOM_SECRET_KEY=

# Database — defaults to sqlite:///./musicbloom.db when unset
# MUSICBLOOM_DATABASE_URL=sqlite:///./musicbloom.db
# MUSICBLOOM_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/musicbloom

# Spotify OAuth (optional — demo mode works without these credentials)
# Register a Spotify app at https://developer.spotify.com/dashboard
# Development callback example:
#   MUSICBLOOM_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/spotify/callback
# MUSICBLOOM_SPOTIFY_CLIENT_ID=
# MUSICBLOOM_SPOTIFY_CLIENT_SECRET=
# MUSICBLOOM_SPOTIFY_REDIRECT_URI=
# MUSICBLOOM_SPOTIFY_SCOPES=user-read-email,user-read-private,user-read-playback-state,user-read-currently-playing
# MUSICBLOOM_SPOTIFY_FRONTEND_SUCCESS_REDIRECT=http://localhost:5173/?spotify=connected
# MUSICBLOOM_SPOTIFY_FRONTEND_FAILURE_REDIRECT=http://localhost:5173/?spotify=error
# MUSICBLOOM_TOKEN_ENCRYPTION_KEY=

# Azure DevOps integration (planned — not yet used)
# AZURE_DEVOPS_ORG=
# AZURE_DEVOPS_PROJECT=
# AZURE_DEVOPS_PAT=
